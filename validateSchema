import re, sys, json, argparse

def fix_json(raw: str) -> str:
    text = raw.strip()

    # Remove trailing commas before } or ]
    text = re.sub(r',\s*([}\]])', r'\1', text)

    # Quote unquoted keys:  name: → "name":
    text = re.sub(r'(?<!["\w])([a-zA-Z_][a-zA-Z0-9_]*)\s*:', r'"\1":', text)

    # Quote unquoted string values
    def quote_value(m):
        prefix = m.group(1)
        value  = m.group(2)
        suffix = m.group(3)
        if re.match(r'^-?\d+(\.\d+)?([eE][+-]?\d+)?$', value):
            return f'{prefix}{value}{suffix}'
        if value in ('true', 'false', 'null'):
            return f'{prefix}{value}{suffix}'
        if value.startswith('"') or value.startswith('[') or value.startswith('{'):
            return f'{prefix}{value}{suffix}'
        return f'{prefix}"{value}"{suffix}'

    text = re.sub(
        r'(:\s*)([^\s,\{\}\[\]"\']+)(\s*[,\}\]]|$)',
        quote_value,
        text
    )

    # Quote unquoted values inside arrays: [rock, jazz] → ["rock", "jazz"]
    def quote_array_item(m):
        value  = m.group(1)
        suffix = m.group(2)
        if re.match(r'^-?\d+(\.\d+)?([eE][+-]?\d+)?$', value):
            return f'{value}{suffix}'
        if value in ('true', 'false', 'null'):
            return f'{value}{suffix}'
        if value.startswith('"'):
            return f'{value}{suffix}'
        return f'"{value}"{suffix}'

    text = re.sub(
        r'(?<=[\[,])\s*([^\s,\[\]{}"\']+)\s*([,\]])',
        lambda m: ' ' + quote_array_item(m),
        text
    )

    return text


def main():
    parser = argparse.ArgumentParser(description="Convert loose payload to valid JSON.")
    parser.add_argument("input",  nargs="?", help="Input file (omit to read from stdin)")
    parser.add_argument("--output", "-o",    help="Output file (omit to print to stdout)")
    args = parser.parse_args()

    if args.input:
        with open(args.input, encoding="utf-8") as f:
            raw = f.read()
    else:
        raw = sys.stdin.read()

    fixed_str = fix_json(raw)

    try:
        parsed = json.loads(fixed_str)
        result = json.dumps(parsed, indent=2)
        success = True
    except json.JSONDecodeError as e:
        result = fixed_str
        success = False
        print(f"[WARN] Could not fully parse: {e}", file=sys.stderr)

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(result)
        print(f"[OK] Saved to {args.output}")
    else:
        print(result)

    sys.exit(0 if success else 1)


if __name__ == "__main__":
    main()


